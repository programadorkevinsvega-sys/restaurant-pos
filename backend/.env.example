NODE_ENV=development
PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# Required: replace with the exact frontend origin(s), comma-separated.
CORS_ORIGINS=https://your-frontend-domain.example
AUTH_COOKIE_SAME_SITE=Lax
# Optional in local development; required in production.
# REDIS_URL=rediss://your-redis-host:6379
# Required only for `pnpm migrate`; use a direct or Session pooler connection, not Transaction mode.
DATABASE_URL=postgresql://user:password@host:5432/database