{
  "name": "restaurant-pos-backend",
  "version": "1.0.0",
  "description": "Backend API para el sistema POS de restaurante",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec \"node --import ./src/instrument.js\" src/server.js",
    "start": "node --import ./src/instrument.js src/server.js",
    "migrate": "node src/migrations/run-migrations.js",
    "user:create": "node scripts/create-user.js",
    "test": "node --test",
    "check": "node --check src/instrument.js && node --check src/server.js && node --test"
  },
  "dependencies": {
    "@sentry/node": "^11.12.0",
    "@sentry/profiling-node": "^11.12.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.3.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
