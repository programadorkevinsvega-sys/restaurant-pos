NODE_ENV=development
PORT=3001
# Generate a unique secret with at least 32 characters for CSRF token signing.
AUTH_CSRF_SECRET=replace-with-a-random-secret-at-least-32-characters
# Required: replace with the exact frontend origin(s), comma-separated.
CORS_ORIGINS=https://your-frontend-domain.example
AUTH_COOKIE_SAME_SITE=Lax
# Optional Sentry project DSN for the backend API. Never commit the real value.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.5
SENTRY_PROFILES_SAMPLE_RATE=0.1
# Private IP of the Nginx reverse-proxy VM that forwards requests to this backend.
TRUSTED_PROXY_IP=10.0.2.82
# Optional in local development; required in production.
# REDIS_URL=redis://restaurant_pos_app:<url-encoded-password>@<redis-private-host>:6379/0
# Runtime connection. Replace host and URL-encode the generated password.
DATABASE_URL=postgresql://restaurant_pos_app:replace-with-url-encoded-password@postgres.private:5432/restaurant_pos
# Migration connection uses the separate owner role and is never used by the API.
MIGRATIONS_DATABASE_URL=postgresql://restaurant_pos_migrator:replace-with-url-encoded-password@postgres.private:5432/restaurant_pos